# ---------------------------------------------------------------------------
# Media, office and CAD files stay local. The site only serves what is in
# /public, so everything below is re-allowed there.
# ---------------------------------------------------------------------------
# images
*.jpg
*.JPG
*.jpeg
*.JPEG
*.png
*.PNG
*.webp
*.gif
*.heic
*.HEIC
*.tif
*.tiff
*.psd
# video / audio
*.mp4
*.MP4
*.mov
*.MOV
*.avi
*.mkv
*.webm
*.aac
*.m4a
*.mp3
*.wav
*.opus
# archives
*.zip
*.rar
*.7z
# documents
*.pdf
*.pptx
*.xlsx
*.xls
*.docx
*.doc
*.idml
*.indd
# fonts
*.ttf
*.otf
# CAD / 3D / cutting machine
*.stl
*.step
*.stp
*.3mf
*.FCStd
*.FCStd1
*.FCBak
*.blend
*.blend1
*.cwprj
*.fcm
# KiCad local state and backups
*.kicad_prl
*-backups/
fp-info-cache
_autosave-*
# site assets are tracked
!/public/**

# ---------------------------------------------------------------------------
# Private business data (this repo is public)
# ---------------------------------------------------------------------------
/_sales/partners/
/_sales/leads/
/Sloper King/financieel/
/Sloper King/shipping/
/Sloper King/competitors/
/Sloper King/content/*
!/Sloper King/content/3d-video/
/Sloper King/content/3d-video/renders/
/fredeq/screenshots/
# scraped data dumps
apify_*.json
*.npy

# Web pages saved from a browser ("Save page as"): the page and its _files folder
*_files/
*.js.download
/Sloper King/*.html
